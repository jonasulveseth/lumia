<% compact = local_assigns[:compact] %>
<%= tag.div id: "approach_#{approach.key}", class: compact ? "py-1" : ui_surface(:panel) + " bg-white dark:bg-zinc-900/60" do %>
  <div class="flex items-start justify-between gap-2">
    <div>
      <p class="text-sm font-medium"><%= approach.name %></p>
      <% unless compact %><p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5"><%= approach.description %></p><% end %>
    </div>
    <% if choice %>
      <span class="<%= ui_badge(choice.stance == "resonates" ? :good : choice.stance == "curious" ? :warn : :neutral) %> shrink-0"><%= t("approaches.stance.#{choice.stance}") %></span>
    <% end %>
  </div>
  <div class="flex flex-wrap gap-1 mt-2">
    <% ApproachChoice::STANCES.each do |stance| %>
      <%= button_to t("approaches.stance.#{stance}"), choice_approach_path(approach.key), method: :put, params: { stance: stance },
            class: ui_button(choice&.stance == stance ? :chip_sm_active : :chip_sm), form_class: "inline" %>
    <% end %>
  </div>
<% end %>
