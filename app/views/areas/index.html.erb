<% content_for :title, t("areas.title") %>
<%= page_header(t("areas.title"), t("areas.subtitle")) %>

<div class="grid sm:grid-cols-2 gap-4">
  <% @life_areas.each do |la| %>
    <% area = la.area %>
    <div class="<%= ui_surface(:card) %> p-5 <%= "opacity-60" unless la.active %>">
      <div class="flex items-start justify-between gap-3">
        <%= link_to area_path(la), class: "flex items-center gap-2 font-semibold" do %>
          <span class="<%= area_color(area, :text) %>"><%= icon(area.icon, css: "w-5 h-5") %></span><%= area.name %>
        <% end %>
        <%= button_to area_path(la), method: :patch, params: { life_area: { active: !la.active } }, class: ui_button(:secondary) do %>
          <%= la.active ? t("areas.deactivate") : t("areas.activate") %>
        <% end %>
      </div>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2"><%= area.description %></p>
      <p class="text-xs text-zinc-400 mt-2"><%= Array(area.topics).join(" · ") %></p>
      <% if la.rating %><p class="mt-3 text-sm"><%= t("areas.rating") %>: <strong><%= la.rating %>/10</strong></p><% end %>
    </div>
  <% end %>
</div>
