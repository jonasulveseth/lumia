<%= form_with model: check_in, class: "space-y-6" do |f| %>
  <% if check_in.errors.any? %><div class="<%= ui_notice(:error) %>"><%= check_in.errors.full_messages.to_sentence %></div><% end %>

  <section class="<%= ui_surface(:card) %>">
    <h2 class="font-semibold mb-1"><%= t("check_ins.ratings_title") %></h2>
    <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4"><%= t("check_ins.ratings_intro") %></p>
    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-4">
      <% current_user.active_life_areas.each do |la| %>
        <div data-controller="range">
          <label class="flex items-center justify-between text-sm mb-1">
            <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full <%= area_color(la.area) %>"></span><%= la.name %></span>
            <span class="font-semibold" data-range-target="output"></span>
          </label>
          <%= range_field_tag "check_in[ratings][#{la.area_key}]", check_in.ratings[la.area_key] || la.rating || 5, min: 1, max: 10, class: "w-full accent-teal-600", data: { range_target: "input", action: "input->range#update" } %>
        </div>
      <% end %>
      <div data-controller="range">
        <label class="flex items-center justify-between text-sm mb-1"><span><%= t("check_ins.energy") %></span><span class="font-semibold" data-range-target="output"></span></label>
        <%= f.range_field :energy, value: check_in.energy || 5, min: 1, max: 10, class: "w-full accent-teal-600", data: { range_target: "input", action: "input->range#update" } %>
      </div>
    </div>
  </section>

  <section class="<%= ui_surface(:card) %> space-y-4">
    <% %i[went_well challenges learned next_focus].each do |field| %>
      <div>
        <%= f.label field, t("check_ins.questions.#{field}"), class: ui_field(:label) %>
        <%= f.text_area field, rows: 3, class: ui_field(:input) %>
      </div>
    <% end %>
  </section>

  <div class="flex justify-end"><%= f.submit t("check_ins.submit"), class: ui_button(:primary) %></div>
<% end %>
