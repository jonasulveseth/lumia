<% content_for :title, t("documents.new") %>
<%= page_header(t("documents.new"), t("documents.new_intro")) %>

<%= form_with model: @document, class: "#{ui_surface(:card)} space-y-5 max-w-2xl" do |f| %>
  <% if @document.errors.any? %><div class="<%= ui_notice(:error) %>"><%= @document.errors.full_messages.to_sentence %></div><% end %>
  <div class="grid sm:grid-cols-3 gap-4">
    <div class="sm:col-span-2">
      <%= f.label :title, t("fields.title"), class: ui_field(:label) %>
      <%= f.text_field :title, placeholder: t("documents.title_placeholder"), class: ui_field(:input) %>
    </div>
    <div>
      <%= f.label :taken_on, t("documents.taken_on"), class: ui_field(:label) %>
      <%= f.date_field :taken_on, class: ui_field(:input) %>
    </div>
  </div>
  <div>
    <%= f.label :kind, t("documents.kind"), class: ui_field(:label) %>
    <%= f.select :kind, Document::KINDS.map { [t("documents.kinds.#{_1}"), _1] }, {}, class: ui_field(:input) %>
  </div>
  <div>
    <%= f.label :file, t("documents.file"), class: ui_field(:label) %>
    <%= f.file_field :file, accept: "application/pdf,text/plain", class: ui_field(:file) %>
    <p class="<%= ui_field(:hint) %>"><%= t("documents.file_hint") %></p>
  </div>
  <div>
    <%= f.label :extracted_text, t("documents.paste"), class: ui_field(:label) %>
    <%= f.text_area :extracted_text, rows: 6, placeholder: t("documents.paste_placeholder"), class: ui_field(:input) %>
  </div>
  <p class="<%= ui_notice(:info) %>"><%= icon("shield", css: "w-4 h-4 mt-0.5") %><%= t("documents.privacy") %></p>
  <div class="flex justify-end"><%= f.submit t("documents.analyze"), class: ui_button(:primary) %></div>
<% end %>
