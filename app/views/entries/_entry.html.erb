<%= tag.div id: dom_id(entry), class: "group flex gap-3 p-3 rounded-xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800" do %>
  <div class="flex-1 min-w-0">
    <div class="flex flex-wrap items-center gap-1.5 mb-1">
      <span class="text-xs text-zinc-500"><%= l(entry.occurred_at, format: :short) %></span>
      <% entry.area_keys.each do |key| %><%= area_badge(key) %><% end %>
      <% if entry.source == "chat" %><span class="<%= ui_badge(:neutral) %>"><%= t("entries.from_chat") %></span><% end %>
      <% unless entry.processed? %>
        <span class="inline-flex items-center gap-1 text-[11px] text-zinc-400"><%= icon("loader-circle", css: "w-3 h-3 animate-spin") %><%= t("entries.processing") %></span>
      <% end %>
    </div>
    <p class="text-sm text-zinc-800 dark:text-zinc-200 whitespace-pre-line"><%= entry.body %></p>
    <% if entry.measurements.any? %>
      <div class="flex flex-wrap gap-1.5 mt-2">
        <% entry.measurements.each do |m| %>
          <span class="<%= ui_badge(:good) %>"><%= m.display_label %>: <%= number_display(m.value) %> <%= m.unit %></span>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= button_to entry_path(entry), method: :delete, class: "#{ui_button(:ghost)} opacity-0 group-hover:opacity-100 self-start", form: { data: { turbo_confirm: t("shared.confirm_delete") } }, title: t("shared.delete") do %>
    <%= icon("trash-2") %>
  <% end %>
<% end %>
