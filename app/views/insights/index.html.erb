<% content_for :title, t("nav.insights") %>
<%= turbo_stream_from current_user, :insights %>
<%= page_header(t("insights.title"), t("insights.subtitle")) { button_to safe_join([icon("sparkles"), t("insights.generate")]), generate_insights_path, class: ui_button(:primary) } %>

<% if @insights.any? %>
  <div class="grid md:grid-cols-2 gap-4">
    <% @insights.each do |i| %>
      <article class="<%= ui_surface(:card) %> p-5 <%= "ring-2 ring-teal-500/30" if i.status == "new" %>">
        <div class="flex flex-wrap gap-1.5 mb-2">
          <span class="<%= ui_badge(:neutral) %>"><%= t("insights.kinds.#{i.kind}") %></span>
          <% i.area_keys.each do |k| %><%= area_badge(k) %><% end %>
        </div>
        <h2 class="font-semibold"><%= i.title %></h2>
        <div class="text-sm text-zinc-700 dark:text-zinc-300 mt-1 prose-lumia"><%= markdown(i.body) %></div>
        <% corr = Array(i.evidence["correlations"]) %>
        <% if corr.any? %>
          <details class="mt-3 text-xs text-zinc-500">
            <summary class="cursor-pointer"><%= t("insights.evidence") %></summary>
            <ul class="mt-1 space-y-0.5">
              <% corr.each do |c| %><li><%= c["a"] %> ↔ <%= c["b"] %>: r = <%= c["r"] %> (n = <%= c["n"] %>)</li><% end %>
            </ul>
          </details>
        <% end %>
        <div class="flex flex-wrap gap-2 mt-4">
          <%= link_to t("insights.test"), new_experiment_path(title: i.title, area: i.area_keys.first), class: ui_button(:secondary) %>
          <%= button_to t("insights.useful"), insight_path(i), method: :patch, params: { status: "useful" }, class: ui_button(i.status == "useful" ? :chip_active : :chip) %>
          <%= button_to t("insights.dismiss"), insight_path(i), method: :patch, params: { status: "dismissed" }, class: ui_button(:ghost) %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <%= empty_state(t("insights.empty")) %>
<% end %>
