<%= form_with url: update_onboarding_path("approaches"), method: :patch, class: "space-y-6" do |f| %>
  <% active_keys = @life_areas.select(&:active).map(&:area_key) %>
  <% groups = Approach.all.select { |a| a.general? || active_keys.include?(a.area_key) }.group_by(&:area_key) %>
  <% groups.each do |area_key, approaches| %>
    <section>
      <h2 class="text-sm font-semibold mb-2"><%= area_key ? Area.find(area_key).name : t("approaches.general") %></h2>
      <div class="grid sm:grid-cols-2 gap-2">
        <% approaches.each do |a| %>
          <% current = @choices[a.key]&.stance %>
          <div class="<%= ui_surface(:panel) %> bg-white dark:bg-zinc-900/60">
            <p class="text-sm font-medium"><%= a.name %></p>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 mb-2"><%= a.description %></p>
            <div class="flex flex-wrap gap-1">
              <% [["", "approaches.stance.none"], *ApproachChoice::STANCES.map { [_1, "approaches.stance.#{_1}"] }].each do |value, label| %>
                <label class="cursor-pointer">
                  <%= radio_button_tag "approaches[#{a.key}]", value, current.to_s == value, class: "peer sr-only" %>
                  <span class="inline-flex px-2.5 py-1 rounded-full text-xs bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 peer-checked:bg-zinc-800 peer-checked:text-white dark:peer-checked:bg-zinc-600"><%= t(label) %></span>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
  <div class="flex justify-between">
    <%= link_to t("onboarding.back"), onboarding_path("areas"), class: ui_button(:secondary) %>
    <%= f.submit t("onboarding.finish"), class: ui_button(:primary) %>
  </div>
<% end %>
