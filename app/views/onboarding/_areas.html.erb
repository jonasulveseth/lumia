<%= form_with url: update_onboarding_path("areas"), method: :patch, class: "space-y-3" do |f| %>
  <% @life_areas.each do |la| %>
    <% area = la.area %>
    <div class="<%= ui_surface(:panel) %> bg-white dark:bg-zinc-900/60">
      <label class="flex items-start gap-3 cursor-pointer">
        <%= hidden_field_tag "areas[#{la.area_key}][active]", "0", id: nil %>
        <%= check_box_tag "areas[#{la.area_key}][active]", "1", la.active, class: "mt-1 accent-teal-600" %>
        <span class="flex-1">
          <span class="flex items-center gap-2 font-medium"><span class="<%= area_color(area, :text) %>"><%= icon(area.icon) %></span><%= area.name %></span>
          <span class="block text-sm text-zinc-500 dark:text-zinc-400"><%= area.description %></span>
        </span>
      </label>
      <div class="mt-3 grid sm:grid-cols-[220px_1fr] gap-3 sm:pl-7">
        <div data-controller="range">
          <label class="<%= ui_field(:label) %>"><%= t("onboarding.areas.rating") %>: <span class="font-semibold" data-range-target="output"></span>/10</label>
          <%= range_field_tag "areas[#{la.area_key}][rating]", la.rating || 5, min: 1, max: 10, class: "w-full accent-teal-600", data: { range_target: "input", action: "input->range#update" } %>
        </div>
        <div>
          <label class="<%= ui_field(:label) %>"><%= t("fields.focus_goal") %></label>
          <%= text_field_tag "areas[#{la.area_key}][focus_goal]", la.focus_goal, placeholder: t("onboarding.areas.goal_placeholder"), class: ui_field(:input) %>
        </div>
      </div>
    </div>
  <% end %>
  <div class="flex justify-between pt-2">
    <%= link_to t("onboarding.back"), onboarding_path("profile"), class: ui_button(:secondary) %>
    <%= f.submit t("onboarding.next"), class: ui_button(:primary) %>
  </div>
<% end %>
