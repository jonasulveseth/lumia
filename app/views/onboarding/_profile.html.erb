<%= form_with model: current_user, url: update_onboarding_path("profile"), method: :patch, class: "#{ui_surface(:card)} space-y-5" do |f| %>
  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, t("fields.name"), class: ui_field(:label) %>
      <%= f.text_field :name, class: ui_field(:input) %>
    </div>
    <div>
      <%= f.label :birth_year, t("fields.birth_year"), class: ui_field(:label) %>
      <%= f.number_field :birth_year, in: 1900..Date.current.year, class: ui_field(:input) %>
    </div>
  </div>
  <div>
    <%= f.label :about_me, t("fields.about_me"), class: ui_field(:label) %>
    <%= f.text_area :about_me, rows: 4, placeholder: t("onboarding.profile.about_placeholder"), class: ui_field(:input) %>
  </div>
  <%= render "shared/coach_style_field", f: f %>
  <div>
    <%= f.label :locale, t("fields.locale"), class: ui_field(:label) %>
    <%= f.select :locale, [["Svenska", "sv"], ["English", "en"]], {}, class: ui_field(:input) %>
  </div>
  <div class="flex justify-end"><%= f.submit t("onboarding.next"), class: ui_button(:primary) %></div>
<% end %>
