<div class="<%= ui_surface(:card) %>">
  <h1 class="text-xl font-semibold mb-6"><%= t("passwords.edit_title") %></h1>
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :password, t("fields.new_password"), class: ui_field(:label) %>
      <%= f.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: ui_field(:input) %>
    </div>
    <div>
      <%= f.label :password_confirmation, t("fields.password_confirmation"), class: ui_field(:label) %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: ui_field(:input) %>
    </div>
    <%= f.submit t("passwords.save"), class: "#{ui_button(:primary)} w-full" %>
  <% end %>
</div>
