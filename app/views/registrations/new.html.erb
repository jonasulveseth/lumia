<% content_for :title, t("registrations.title") %>
<div class="<%= ui_surface(:card) %>">
  <h1 class="text-xl font-semibold mb-1"><%= t("registrations.title") %></h1>
  <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-6"><%= t("registrations.subtitle") %></p>
  <%= form_with model: @user, url: registration_path, class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="<%= ui_notice(:error) %>"><%= @user.errors.full_messages.to_sentence %></div>
    <% end %>
    <div>
      <%= f.label :name, t("fields.name"), class: ui_field(:label) %>
      <%= f.text_field :name, autofocus: true, class: ui_field(:input) %>
    </div>
    <div>
      <%= f.label :email_address, t("fields.email"), class: ui_field(:label) %>
      <%= f.email_field :email_address, required: true, autocomplete: "username", class: ui_field(:input) %>
    </div>
    <div>
      <%= f.label :password, t("fields.password"), class: ui_field(:label) %>
      <%= f.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: ui_field(:input) %>
      <p class="<%= ui_field(:hint) %>"><%= t("registrations.password_hint") %></p>
    </div>
    <%= f.submit t("registrations.submit"), class: "#{ui_button(:primary)} w-full" %>
  <% end %>
  <p class="mt-6 text-sm text-center"><%= link_to t("registrations.have_account"), new_session_path, class: "text-zinc-500 hover:text-zinc-900 dark:hover:text-white" %></p>
</div>
