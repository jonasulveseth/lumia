<% content_for :title, t("nav.settings") %>
<%= page_header(t("settings.title")) %>

<%= form_with model: current_user, url: settings_path, method: :patch, class: "#{ui_surface(:card)} space-y-5 max-w-2xl" do |f| %>
  <% if current_user.errors.any? %><div class="<%= ui_notice(:error) %>"><%= current_user.errors.full_messages.to_sentence %></div><% end %>
  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, t("fields.name"), class: ui_field(:label) %>
      <%= f.text_field :name, class: ui_field(:input) %>
    </div>
    <div>
      <%= f.label :email_address, t("fields.email"), class: ui_field(:label) %>
      <%= f.email_field :email_address, class: ui_field(:input) %>
    </div>
    <div>
      <%= f.label :birth_year, t("fields.birth_year"), class: ui_field(:label) %>
      <%= f.number_field :birth_year, class: ui_field(:input) %>
    </div>
    <div>
      <%= f.label :locale, t("fields.locale"), class: ui_field(:label) %>
      <%= f.select :locale, [["Svenska", "sv"], ["English", "en"]], {}, class: ui_field(:input) %>
    </div>
  </div>
  <div>
    <%= f.label :about_me, t("fields.about_me"), class: ui_field(:label) %>
    <%= f.text_area :about_me, rows: 4, class: ui_field(:input) %>
  </div>
  <%= render "shared/coach_style_field", f: f %>
  <div class="flex justify-end"><%= f.submit t("shared.save"), class: ui_button(:primary) %></div>
<% end %>
