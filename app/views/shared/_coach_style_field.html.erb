<fieldset>
  <legend class="<%= ui_field(:label) %>"><%= t("fields.coach_style") %></legend>
  <div class="grid sm:grid-cols-2 gap-2">
    <% Coaching.styles.each do |style| %>
      <label class="flex gap-3 p-3 rounded-xl border border-zinc-200 dark:border-zinc-700/60 cursor-pointer has-[:checked]:border-teal-500 has-[:checked]:bg-teal-50/60 dark:has-[:checked]:bg-teal-500/10">
        <%= f.radio_button :coach_style, style, class: "mt-1 accent-teal-600" %>
        <span>
          <span class="block text-sm font-medium"><%= t("coach_styles.#{style}.name") %></span>
          <span class="block text-xs text-zinc-500 dark:text-zinc-400"><%= t("coach_styles.#{style}.description") %></span>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
