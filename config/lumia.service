# systemd-tjänst för Lumia på den här maskinen.
# Installera: sudo cp config/lumia.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now lumia
[Unit]
Description=Lumia Rails Application
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=jonas
WorkingDirectory=/home/jonas/sites/lumia
Environment="RAILS_ENV=production"
Environment="PORT=3077"
Environment="RAILS_MAX_THREADS=5"
# Bakgrundsjobben (loggtolkning, provsvar, coachsvar, mönster) körs i Puma-processen.
Environment="SOLID_QUEUE_IN_PUMA=true"
Environment="RAILS_LOG_LEVEL=info"
Environment="OLLAMA_BASE_URL=http://localhost:11434"
Environment="BUNDLE_GEMFILE=/home/jonas/sites/lumia/Gemfile"
Environment="PATH=/usr/share/rvm/gems/ruby-3.4.5/bin:/usr/share/rvm/gems/ruby-3.4.5@global/bin:/usr/share/rvm/rubies/ruby-3.4.5/bin:/usr/share/rvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="GEM_HOME=/usr/share/rvm/gems/ruby-3.4.5"
Environment="GEM_PATH=/usr/share/rvm/gems/ruby-3.4.5:/usr/share/rvm/gems/ruby-3.4.5@global"

ExecStart=/usr/share/rvm/gems/ruby-3.4.5/bin/bundle exec puma -C config/puma.rb
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumia

[Install]
WantedBy=multi-user.target
